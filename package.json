{
  "name": "pdf-to-audiobook",
  "desktopName": "com.ikicker.pdf-to-audiobook",
  "version": "3.0.30",
  "description": "Convert PDF documents to high-quality audiobooks using Kokoro TTS",
  "main": "out/main/index.js",
  "author": "Inner Ninja",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build:old": "electron-vite build",
    "build": "electron-vite build && electron-builder --publish never",
    "build:python": "pyinstaller --log-level WARN --collect-all spacy --collect-all en_core_web_sm --copy-metadata en_core_web_sm --copy-metadata spacy --collect-all thinc --collect-all srsly --collect-all spacy_legacy --collect-all spacy_loggers --collect-all cymem --collect-all preshed --collect-all murmurhash --collect-all blis --collect-all catalogue --collect-all wasabi --collect-all weasel --collect-all confection --collect-all espeakng_loader --collect-all kokoro --collect-all misaki --collect-all transformers --collect-all language_tags --collect-data espeakng_loader --copy-metadata torch --copy-metadata tqdm --copy-metadata regex --copy-metadata requests --copy-metadata packaging --copy-metadata filelock --copy-metadata numpy --copy-metadata tokenizers --onedir PDF_to_Audiobook.py",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --publish never",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:win:store": "electron-vite build && electron-builder --win appx --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "41.10.7",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "6.0.2",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.innerninja.pdf-to-audiobook",
    "productName": "PDFToAudiobook",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "out/**/*",
      "PDF_to_Audiobook.py",
      "pyproject.toml"
    ],
    "asarUnpack": [
      "ffmpeg/**/*"
    ],
    "win": {
      "target": ["nsis", "appx"],
      "icon": "frm_Main/favicon.ico"
    },
    "mac": {
       "target": ["dmg", "zip"],
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": [ "AppImage", "deb", "rpm" ],
      "icon": "frm_Main/favicon.png",
      "category": "Utility",
      "maintainer": "Inner Ninja <your-email@example.com>"
    },
    "appx": {
      "identityName": "JohnCarlson.PDFToAudiobook",
      "publisher": "CN=8A2CB2FC-2019-41E3-B5EB-6DDF69819614",
      "publisherDisplayName": "John Carlson",
      "applicationId": "PDFToAudiobook",
      "displayName": "PDFToAudiobook",
      "backgroundColor": "#1a1a1a",
      "languages": [
        "en-US"
      ],
      "showNameOnTiles": false
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": true,
      "include": "frm_Main/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PDF to AudioBook"
    },
    "extraResources": [
      {
        "from": "PDF_to_Audiobook.py",
        "to": "PDF_to_Audiobook.py"
      },
      {
        "from": "dist/PDF_to_Audiobook",
        "to": "PDF_to_Audiobook"
      },
      {
        "from": "pyproject.toml",
        "to": "pyproject.toml"
      },
      {
        "from": "ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-winstaller": true
  }
}
